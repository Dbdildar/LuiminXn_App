{
  "name": "luminxn",
  "version": "0.1.0",
  "private": true,
  "description": "LuminXn - Android video streaming app built with React Native",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml}\"",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand",
    "detox:build": "detox build --configuration android.emu.release",
    "detox:test": "detox test --configuration android.emu.release --headless --record-logs failing --take-screenshots failing --cleanup",
    "detox:build:debug": "detox build --configuration android.emu.debug",
    "detox:test:debug": "detox test --configuration android.emu.debug",
    "build:apk:debug": "cd android && ./gradlew assembleDebug",
    "build:apk:release": "cd android && ./gradlew assembleRelease",
    "build:aab:release": "cd android && ./gradlew bundleRelease",
    "clean:android": "cd android && ./gradlew clean",
    "validate": "npm run lint && npm run typecheck && npm run test:ci"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "react": "19.0.0",
    "react-native": "0.79.7",
    "react-native-orientation-locker": "^1.7.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.19.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.1",
    "@react-native-community/cli-platform-android": "18.0.1",
    "@react-native/babel-preset": "0.79.7",
    "@react-native/eslint-config": "0.79.7",
    "@react-native/metro-config": "0.79.7",
    "@react-native/typescript-config": "0.79.7",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "detox": "20.51.4",
    "eslint": "^8.19.0",
    "eslint-plugin-jest": "28.14.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
